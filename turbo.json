{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "generate": {
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "generate"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^build", "generate"],
      "env": ["DATABASE_URL", "TEST_DATABASE_URL"]
    },
    "typecheck": {
      "dependsOn": ["^build", "^typecheck", "generate"]
    },
    "clean": {
      "cache": false
    }
  }
}
