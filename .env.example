# PostgreSQL local
POSTGRES_DB=tally
POSTGRES_USER=tally
POSTGRES_PASSWORD=tally
POSTGRES_PORT=5433
DATABASE_URL=postgresql://tally:tally@localhost:5433/tally?schema=public

# Redis local
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

# API local
NODE_ENV=development
API_PORT=3001
CORS_ORIGIN=http://localhost:3000

# Auth / JWT (ADR-0008) — gere segredos fortes por ambiente, nunca reutilize os de baixo.
# Ex.: openssl rand -base64 48
JWT_ACCESS_SECRET=changeme-access-secret-min-16-chars
JWT_REFRESH_SECRET=changeme-refresh-secret-min-16-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_ISSUER=tally-api
JWT_AUDIENCE=tally-web
# Deixe vazio para cookies host-only; defina só se a topologia de produção exigir.
COOKIE_DOMAIN=

# Web (Next.js) — URL pública da API para o browser.
NEXT_PUBLIC_API_URL=http://localhost:3001/v1

# OAuth (Google/GitHub) — o fluxo roda na API NestJS (ADR-0008), que emite os
# mesmos cookies de sessão. Deixe vazio para desabilitar o provider.
# Callback a registrar no provider: {API_PUBLIC_URL}/v1/auth/oauth/{google|github}/callback
API_PUBLIC_URL=http://localhost:3001
WEB_APP_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=